BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MYOS_PATH)/board/qemu-x86_64/rootfs-overlay $(BR2_EXTERNAL_MYOS_PATH)/board/qemu-x86_64/gui-overlay"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MYOS_PATH)/board/qemu-x86_64/linux.fragment $(BR2_EXTERNAL_MYOS_PATH)/board/qemu-x86_64/linux-gui.fragment"
BR2_TARGET_ROOTFS_EXT2_SIZE="768M"
BR2_PACKAGE_EUDEV_ENABLE_HWDB=y
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_DEFAULT_DRM=y
# BR2_PACKAGE_WESTON_SHELL_FULLSCREEN is not set
# BR2_PACKAGE_WESTON_SHELL_IVI is not set
# BR2_PACKAGE_WESTON_SHELL_KIOSK is not set
# BR2_PACKAGE_WESTON_SCREENSHARE is not set
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_PYTHON3_CURSES=y
BR2_PACKAGE_NCURSES_WCHAR=y

# --- Target ---------------------------------------------------------------
BR2_x86_64=y

# --- Toolchain: Buildroot-built glibc + C++ (Rust needs glibc, OpenJDK too) -
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_CCACHE=y
# Buildroot's QEMU patches, then ours (build/patches/<package>/): Phase 6
# backports a glibc 2.42+ build fix to OpenJDK 21.0.4.
BR2_GLOBAL_PATCH_DIR="board/qemu/patches $(BR2_EXTERNAL_MYOS_PATH)/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

# --- System ---------------------------------------------------------------
BR2_TARGET_GENERIC_HOSTNAME="myos"
BR2_TARGET_GENERIC_ISSUE="Welcome to myos (phase 6)"
BR2_TARGET_GENERIC_ROOT_PASSWD="myos"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MYOS_PATH)/board/qemu-x86_64/rootfs-overlay"

# --- Kernel: Buildroot's tested QEMU config + our fragment -----------------
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/x86_64/linux.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MYOS_PATH)/board/qemu-x86_64/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
# Phase 5: /boot/bzImage in the rootfs, for myos-install to copy
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# --- Root filesystem ------------------------------------------------------
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
# BR2_TARGET_ROOTFS_TAR is not set

# --- Host tools: QEMU (so you don't need a system one) and Rust ------------
BR2_PACKAGE_HOST_QEMU=y
BR2_PACKAGE_HOST_QEMU_SYSTEM_MODE=y
BR2_PACKAGE_HOST_RUSTC=y

# --- Language runtimes on target -----------------------------------------
BR2_PACKAGE_PYTHON3=y

# --- myos packages (toolchain smoke tests) --------------------------------
BR2_PACKAGE_MYOS_HELLO_RUST=y
BR2_PACKAGE_MYOS_HELLO_CPP=y

# --- Phase 1: our Rust PID 1 (rust/init) ----------------------------------
# No Buildroot init system; myos-init is /sbin/init. The serial getty is
# /etc/myos/services/getty.toml in the rootfs overlay.
BR2_INIT_NONE=y
BR2_PACKAGE_MYOS_INIT=y

# --- Phase 2: IPC bus ------------------------------------------------------
BR2_PACKAGE_MYOS_BUS=y
BR2_PACKAGE_MYOS_BUS_CPP=y
BR2_PACKAGE_MYOS_BUS_PYTHON=y

# --- Phase 3: core services (logd, netd, sysinfod) -------------------------
# They replace BusyBox syslogd, klogd and ifup/udhcpc in the service files.
BR2_PACKAGE_MYOS_SERVICES=y

# --- Phase 4: C++ shell and utilities --------------------------------------
# msh is root's login shell; /bin/sh stays BusyBox ash for scripts. Our ls,
# cat, ps and top replace BusyBox's (ps and top read sysinfod over the bus).
BR2_PACKAGE_MYOS_MSH=y
BR2_PACKAGE_MYOS_UTILS=y

# --- Phase 5: Python admin tools (myctl, myos-install) -----------------------
# myos-install needs mkfs.ext4 (e2fsprogs, selected by myos-admin) and GRUB
# for BIOS. GRUB isn't used to boot this image (QEMU loads the kernel
# directly); its boot sector and core image are what myos-install writes to
# the disk it installs onto. The core image finds its config on the first
# partition of the disk the BIOS booted from, and has the serial console
# built in so the menu shows on ttyS0.
BR2_PACKAGE_MYOS_ADMIN=y
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_BOOT_PARTITION="hd0,msdos1"
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="boot linux ext2 fat part_msdos part_gpt normal biosdisk serial terminal"

# --- Phase 6: Java app runtime ----------------------------------------------
# OpenJDK 21 is built (full JDK, for its jmods), jlink'd down to
# /usr/lib/myos/jdk, then removed from the target. jrun (in myos-services)
# installs and runs app packages; the sample is in /usr/share/myos/apps.
# `make WITH_JAVA=0` leaves all of this out (build/configs/no-java.fragment).
BR2_PACKAGE_OPENJDK=y
BR2_PACKAGE_OPENJDK_VERSION_21=y
BR2_PACKAGE_OPENJDK_FULL_JDK=y
BR2_PACKAGE_MYOS_BUS_JAVA=y
BR2_PACKAGE_MYOS_JAVA=y

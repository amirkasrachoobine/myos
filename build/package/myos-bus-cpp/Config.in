config BR2_PACKAGE_MYOS_BUS_CPP
	bool "myos-bus-cpp"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_PACKAGE_PROTOBUF_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_8
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_PROTOBUF
	help
	  C++ client library for the myos IPC bus, and the
	  myos-bus-ping-cpp test client. libmyosbus, its headers and
	  myos-bus.pc go to staging for the Phase 4 tools.

comment "myos-bus-cpp needs a toolchain w/ C++, threads, dynamic library, gcc >= 8"
	depends on BR2_PACKAGE_PROTOBUF_ARCH_SUPPORTS
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS \
		|| BR2_STATIC_LIBS || !BR2_TOOLCHAIN_GCC_AT_LEAST_8

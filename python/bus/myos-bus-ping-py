#!/usr/bin/env python3
"""myos-bus-ping-py [MESSAGE]: the Python client's Phase 2 check.

Exits 0 and prints `pong: "<message>" from busd X in N ms` on success.
"""
import json
import sys
import time

from myos.bus import BusError, Client


def main():
    message = " ".join(sys.argv[1:]) or "hello from Python"
    try:
        with Client() as bus:
            t0 = time.monotonic()
            pong = bus.ping(message)
            ms = (time.monotonic() - t0) * 1000
    except BusError as e:
        print(f"myos-bus-ping-py: {e}", file=sys.stderr)
        return 1
    print(f"pong: {json.dumps(pong.message, ensure_ascii=False)} from {pong.broker_version} in {ms:.2f} ms")
    return 0


if __name__ == "__main__":
    sys.exit(main())
